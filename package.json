{
  "name": "carnet-de-messe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "browser:install": "playwright install chromium",
    "mail:dev": "node --env-file-if-exists=.env.local scripts/mail-dev.mjs",
    "format": "prettier --write app components lib types tests scripts playwright*.config.ts package.json README.md",
    "format:check": "prettier --check app components lib types tests scripts playwright*.config.ts package.json README.md"
  },
  "dependencies": {
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-auth": "^1.7.7",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "page-flip": "^2.0.7",
    "playwright": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-moveable": "^0.56.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
