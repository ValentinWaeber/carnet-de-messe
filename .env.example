# Node.js 24.15+; settings remain on the server.
BETTER_AUTH_URL=http://localhost:3000
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=
ADMIN_EMAILS=admin@example.com
DATA_DIR=.data
# local: test inbox on disk, only with npm run dev. smtp: real email delivery.
MAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Maison du carnet <contact@example.com>
